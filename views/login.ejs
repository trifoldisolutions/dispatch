<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Log in — Dispatch</title>
<style>
  /* The dashboard's colors and type (views/index.ejs :root) */
  :root {
    color-scheme: light dark;
    --bg: #f5f5f4;
    --panel: #ffffff;
    --border: #e2e0dc;
    --text: #1c1917;
    --text-dim: #78716c;
    --accent: #2563eb;
    --danger: #dc2626;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #18181b;
      --panel: #232326;
      --border: #38383c;
      --text: #f4f4f5;
      --text-dim: #a1a1aa;
      --danger: #f87171;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: var(--bg);
    color: var(--text);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .login {
    width: 100%;
    max-width: 340px;
  }
  .login-heading { margin: 0 0 20px; text-align: center; }
  .login-title { margin: 0; font-size: 22px; font-weight: 600; }
  .login-subtitle { margin: 2px 0 0; font-size: 13px; color: var(--text-dim); }
  .login-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .login-error {
    margin: 0;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 8%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--danger) 45%, var(--border));
    border-radius: 6px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-size: 13px; font-weight: 600; }
  .field-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 13px;
  }
  .field-input:focus { outline: none; border-color: var(--accent); }
  .login-btn {
    margin-top: 4px;
    padding: 9px 12px;
    border: none;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .login-btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
  .login-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
</head>
<body>
<main class="login">
  <div class="login-heading">
    <h1 class="login-title">Dispatch</h1>
    <p class="login-subtitle">Trifoldi Solutions</p>
  </div>
  <form class="login-card" method="post" action="/login">
    <% if (error) { %>
    <p class="login-error" role="alert"><%= error %></p>
    <% } %>
    <input type="hidden" name="next" value="<%= next %>">
    <label class="field">
      <span class="field-label">Email</span>
      <input class="field-input" type="email" name="email" value="<%= email %>" autocomplete="username" maxlength="254" required<%= email ? "" : " autofocus" %>>
    </label>
    <label class="field">
      <span class="field-label">Password</span>
      <input class="field-input" type="password" name="password" autocomplete="current-password" maxlength="<%= passwordMaxLength %>" required<%= email ? " autofocus" : "" %>>
    </label>
    <button class="login-btn" type="submit">Log in</button>
  </form>
</main>
</body>
</html>
