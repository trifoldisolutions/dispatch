<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title><%= account && account.status === "invited" ? "Set up your account" : "Set a new password" %> — Dispatch</title>
<%- include("../partials/auth-style") %>
</head>
<body>
<%# A password link's page (routes/app.js): with a good link, the form that sets
    the password; otherwise only why there's nothing to set. The email rides
    along hidden, so a password manager saves the new password under it. %>
<main class="login">
  <div class="login-heading">
    <h1 class="login-title">Dispatch</h1>
    <p class="login-subtitle">Trifoldi Solutions</p>
  </div>
  <% if (account) { %>
  <% const invite = account.status === "invited"; %>
  <form class="login-card" method="post">
    <p class="login-text">
      <% if (invite) { %>Welcome, <%= account.name.split(" ")[0] %>. Choose a password for <strong><%= account.email %></strong> to finish setting up your account.
      <% } else { %>Choose a new password for <strong><%= account.email %></strong>.<% } %>
    </p>
    <% if (error) { %>
    <p class="login-error" role="alert"><%= error %></p>
    <% } %>
    <input type="email" name="email" value="<%= account.email %>" autocomplete="username" hidden readonly>
    <label class="field">
      <span class="field-label">Password</span>
      <input class="field-input" type="password" name="password" autocomplete="new-password" minlength="<%= minLength %>" maxlength="<%= maxLength %>" required autofocus>
      <span class="field-hint">At least <%= minLength %> characters.</span>
    </label>
    <label class="field">
      <span class="field-label">Repeat it</span>
      <input class="field-input" type="password" name="confirm" autocomplete="new-password" minlength="<%= minLength %>" maxlength="<%= maxLength %>" required>
    </label>
    <button class="login-btn" type="submit"><%= invite ? "Set password and log in" : "Save password and log in" %></button>
  </form>
  <% } else { %>
  <div class="login-card">
    <p class="login-error" role="alert"><%= notice %></p>
    <a class="login-link" href="/login">Go to log in</a>
  </div>
  <% } %>
</main>
</body>
</html>
