<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trifoldi Solutions — Dispatch</title>
<link rel="stylesheet" href="/css/dispatch.css">
<link rel="stylesheet" href="/output.css">
<script type="importmap" nonce="<%= cspNonce %>">
{
  "imports": {
    "preact": "/vendor/preact.mjs",
    "preact/hooks": "/vendor/preact-hooks.mjs",
    "htm": "/vendor/htm.mjs",
    "@preact/signals-core": "/vendor/signals-core.mjs",
    "@preact/signals": "/vendor/signals.mjs"
  }
}
</script>
</head>
<%# data-admin: an admin oversees the projects without working on them, so
    Users is their only page (public/js/app/store.js and
    public/js/legacy/router.js read it; the server checks for itself).
    data-user: whose page this is, which /live checks it against
    (public/js/app/live.js). %>
<body data-user="<%= user._id %>"<%- user.isAdmin ? " data-admin" : "" %>>
<%# The left menu: Projects, places kept for Inbox and Chat, then Dispatch's
    own page, the Switcher (public/js/app/switchboard.js) and the
    account; an admin's has Users and no Dispatch or Switcher (the
    command palette has no place here: Ctrl+K opens it, see
    public/js/app/palette.js). Under 640px it's a bar along the bottom
    instead. render() (public/js/legacy/router.js) marks the current page
    with aria-current. %>
<nav id="rail" class="tw-reset fixed z-30 flex bg-panel border-line
  max-sm:inset-x-0 max-sm:bottom-0 max-sm:h-14 max-sm:flex-row max-sm:items-center max-sm:justify-around max-sm:border-t
  sm:inset-y-0 sm:left-0 sm:w-[72px] sm:flex-col sm:items-center sm:gap-1 sm:border-r sm:py-3" aria-label="Dispatch">
  <a href="/" data-route class="max-sm:hidden mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent text-[15px] font-bold text-white" title="Dispatch">D</a>
  <% const railItem = "flex w-14 flex-col items-center gap-1 rounded-lg py-2 text-[11px] font-medium text-dim hover:bg-line/50 hover:text-fg aria-[current=page]:bg-accent/15 aria-[current=page]:text-fg"; %>
  <% const railSoon = "flex w-14 flex-col items-center gap-1 rounded-lg py-2 text-[11px] font-medium text-dim opacity-45 cursor-default max-sm:hidden"; %>
  <% if (user.isAdmin) { %>
  <a href="/users" data-route data-rail="users" class="<%= railItem %>" title="Everyone's accounts">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 19c.5-3 3-5 6-5s5.5 2 6 5M16 4.5a3.5 3.5 0 0 1 0 7M18 14c1.7.6 2.8 2.4 3 5"/></svg>
    Users
  </a>
  <% } else { %>
  <a href="/projects" data-route data-rail="projects" class="<%= railItem %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg>
    Projects
  </a>
  <% } %>
  <span class="<%= railSoon %>" title="Shared mailboxes: coming soon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4.5M4 13.5 6.5 5h11l2.5 8.5M4 13.5h4.5l1.5 2.5h4l1.5-2.5H20"/></svg>
    Inbox
  </span>
  <span class="<%= railSoon %>" title="Chat: coming soon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12a5 5 0 0 1 7 7m-7-7a5 5 0 0 0-2 4a5 5 0 0 0 .224 1.483c.272.88.076 1.86-.099 2.784a.468.468 0 0 0 .592.539c.848-.232 1.691-.43 2.557-.112A5 5 0 0 0 8 21a4.99 4.99 0 0 0 4-2m-7-7c0-4.685 2.875-9 8-9a8 8 0 0 1 7.532 10.7c-.476 1.326.037 3.102.337 4.568a.451.451 0 0 1-.584.526c-1.312-.41-2.852-.986-4.085-.466c-1.334.562-2.736.672-4.2.672"/></svg>
    Chat
  </span>
  <span class="max-sm:hidden flex-1"></span>
  <% if (!user.isAdmin) { %>
  <a href="/dispatch" data-route data-rail="self" class="<%= railItem %>" title="Dispatch's own page: its files, tasks, journal and history">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
    Dispatch
  </a>
  <button id="switch-board-btn" type="button" aria-haspopup="dialog" aria-expanded="false" class="<%= railItem %> aria-expanded:bg-accent/15 aria-expanded:text-fg max-sm:gap-0.5 max-sm:py-1" title="Every project by category and port, to drag between them">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/></svg>
    <span class="text-center leading-[1.15] max-sm:leading-none">Switcher</span>
  </button>
  <% } %>
  <%# The account: its avatar opens a popup (a popover, so a click beside it
      or Escape closes it) with the name, email and Log out. main.js places
      it beside the avatar, or above it on the phone's bottom bar. %>
  <% const userAvatar = avatarUrl(user); %>
  <%# With no picture, mynaui's user icon stands in, as on every avatar. %>
  <% const userIcon = (size) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 7.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0m4.5 13c-.475-9.333-14.525-9.333-15 0"/></svg>`; %>
  <button id="account-btn" type="button" popovertarget="account-menu" aria-label="Your account" title="<%= user.name %>"
    class="flex h-8 w-8 items-center justify-center rounded-full bg-line text-dim outline-none ring-2 ring-transparent ring-offset-2 ring-offset-panel hover:ring-line focus-visible:ring-accent aria-expanded:ring-accent sm:mt-2"><% if (userAvatar) { %><img src="<%= userAvatar %>" alt="" class="h-full w-full rounded-full object-cover"><% } else { %><%- userIcon(18) %><% } %></button>
  <div id="account-menu" popover class="inset-auto m-0 w-[300px] max-w-[calc(100vw-16px)] rounded-lg border border-line bg-panel p-3 text-fg shadow-[0_8px_20px_rgba(0,0,0,0.25)]">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-line text-dim"><% if (userAvatar) { %><img src="<%= userAvatar %>" alt="" class="h-full w-full rounded-full object-cover"><% } else { %><%- userIcon(22) %><% } %></span>
      <span class="flex min-w-0 flex-1 flex-col gap-0.5">
        <span class="truncate text-[13px] font-semibold"><%= user.name %></span>
        <span class="truncate text-[12px] text-dim"><%= user.email %></span>
      </span>
      <form method="post" action="/logout" class="m-0 shrink-0">
        <button type="submit" class="flex h-8 items-center gap-1.5 rounded-md border border-line px-2.5 text-[12px] font-medium text-dim hover:border-danger/50 hover:text-danger">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-2" /><path d="M10 12h10" /><path d="m17 9 3 3-3 3" />
          </svg>
          Log out
        </button>
      </form>
    </div>
  </div>
</nav>

<div class="app-main sm:pl-[72px] max-sm:pb-14">
<div id="status" class="toast" role="status" aria-live="polite">
  <span class="toast-icon"></span>
  <span class="toast-text"></span>
  <button type="button" class="toast-close" aria-label="Dismiss">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>
</div>
<%# Up to three columns: on project pages, the list of your projects
    (#project-list-root, drawn by public/js/app/projects.js; under 1280px it
    opens over the page instead, from the toolbar's Projects), the page
    itself, and from a 2072px window a side column (#create-side): the
    Add/Edit project form (filled by renderCreateForm in
    public/js/legacy/project-form.js), then your tasks on other projects,
    the commit messages waiting for a push, and People (#side-root, drawn
    by public/js/app/side.js). The page's
    layouts follow its own column's width (container queries on
    .app-content), not the window's. %>
<div class="app-columns">
<div id="project-list-root" class="tw-reset contents"></div>
<div class="app-content">
<%# Project pages only: the project list (under 1280px), back to a
    section's project, then the project's own line over its header box
    (#project-bar, filled by buildProjectBar in
    public/js/legacy/project-page.js): its name, port, Switch, Eject and
    Sync, and its actions at the right end. %>
<div id="toolbar" class="toolbar" hidden>
  <div class="toolbar-left">
    <button id="project-list-btn" class="toolbar-link project-list-btn" type="button" aria-label="Your projects" title="Your projects">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>Projects
    </button>
    <a id="back-link" class="toolbar-link" href="/" data-route hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
  </div>
  <div id="project-bar" class="project-bar"></div>
</div>

<div id="project-view" class="project-view" hidden></div>

<%# / and /projects while they find your project (or when there's none to
    show), /people, and an admin's /users: drawn by public/js/app (Preact). %>
<div id="app-view" class="tw-reset" hidden></div>
</div>
<aside id="create-side" class="create-side" aria-label="Add project, your tasks, ready to push and people" hidden>
  <div id="create-project-side"></div>
  <div id="side-root" class="tw-reset"></div>
</aside>
</div>
</div>

<%# The Add/Edit project form, sliding in from the right. %>
<div id="create-drawer" class="drawer-overlay" hidden>
  <aside class="drawer-panel" aria-label="Project details">
    <div id="create-project"></div>
  </aside>
</div>

<div id="confirm-overlay" class="modal-overlay confirm-overlay" hidden>
  <div id="confirm-panel" class="modal-panel-inner confirm-panel" role="alertdialog" aria-modal="true"></div>
</div>

<div id="new-folders-overlay" class="modal-overlay" hidden>
  <div id="new-folders-panel"></div>
</div>

<div id="palette-root" class="tw-reset"></div>
<%# The Switcher (public/js/app/switchboard.js), under confirm dialogs. %>
<div id="switch-board-root" class="tw-reset"></div>

<script src="/js/legacy/constants.js" defer></script>
<script src="/js/legacy/state.js" defer></script>
<script src="/js/legacy/ui.js" defer></script>
<script src="/js/legacy/api.js" defer></script>
<script src="/js/legacy/registry.js" defer></script>
<script src="/js/legacy/ports.js" defer></script>
<script src="/js/legacy/project-form.js" defer></script>
<script src="/js/legacy/explorer.js" defer></script>
<script src="/js/legacy/history.js" defer></script>
<script src="/js/legacy/journal.js" defer></script>
<script src="/js/legacy/tasks.js" defer></script>
<script src="/js/legacy/staff.js" defer></script>
<script src="/js/legacy/project-page.js" defer></script>
<script src="/js/legacy/router.js" defer></script>
<script src="/js/legacy/boot.js" defer></script>
<script type="module" src="/js/app/main.js"></script>
</body>
</html>
