<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trifoldi Solutions — Dispatch</title>
<link rel="stylesheet" href="/css/dispatch.css">
<link rel="stylesheet" href="/output.css">
<script type="importmap" nonce="<%= cspNonce %>">
{
  "imports": {
    "preact": "/vendor/preact.mjs",
    "preact/hooks": "/vendor/preact-hooks.mjs",
    "htm": "/vendor/htm.mjs",
    "@preact/signals-core": "/vendor/signals-core.mjs",
    "@preact/signals": "/vendor/signals.mjs"
  }
}
</script>
</head>
<body>
<%# The left menu: the app's pages, Search (the command palette), places
    kept for Inbox and Chat, then Dispatch's own page and the account. Under
    640px it's a bar along the bottom instead. render()
    (public/js/legacy/router.js) marks the current page with aria-current. %>
<nav id="rail" class="tw-reset fixed z-30 flex bg-panel border-line
  max-sm:inset-x-0 max-sm:bottom-0 max-sm:h-14 max-sm:flex-row max-sm:items-center max-sm:justify-around max-sm:border-t
  sm:inset-y-0 sm:left-0 sm:w-[72px] sm:flex-col sm:items-center sm:gap-1 sm:border-r sm:py-3" aria-label="Dispatch">
  <a href="/" data-route class="max-sm:hidden mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent text-[15px] font-bold text-white" title="Dispatch">D</a>
  <% const railItem = "flex w-14 flex-col items-center gap-1 rounded-lg py-2 text-[11px] font-medium text-dim hover:bg-line/50 hover:text-fg aria-[current=page]:bg-accent/15 aria-[current=page]:text-fg"; %>
  <% const railSoon = "flex w-14 flex-col items-center gap-1 rounded-lg py-2 text-[11px] font-medium text-dim opacity-45 cursor-default max-sm:hidden"; %>
  <a href="/" data-route data-rail="home" class="<%= railItem %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/></svg>
    Home
  </a>
  <a href="/projects" data-route data-rail="projects" class="<%= railItem %>">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg>
    Projects
  </a>
  <%# Opens the command palette (public/js/app/palette.js), as Ctrl+K does. %>
  <button id="palette-btn" type="button" class="<%= railItem %>" title="Jump to a page, project or action (Ctrl K)">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    Search
  </button>
  <span class="<%= railSoon %>" title="Shared mailboxes: coming soon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4.5M4 13.5 6.5 5h11l2.5 8.5M4 13.5h4.5l1.5 2.5h4l1.5-2.5H20"/></svg>
    Inbox
  </span>
  <span class="<%= railSoon %>" title="Chat: coming soon">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 18.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8.5z"/><path d="M9 9h6M9 12h4"/></svg>
    Chat
  </span>
  <span class="max-sm:hidden flex-1"></span>
  <a href="/dispatch" data-route data-rail="self" class="<%= railItem %>" title="Dispatch's own page: its files, tasks, journal and history">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
    Dispatch
  </a>
  <form method="post" action="/logout" class="m-0 flex flex-col items-center gap-1.5 sm:mt-2">
    <% const userAvatar = avatarUrl(user); %>
    <span class="max-sm:hidden flex h-8 w-8 items-center justify-center rounded-full bg-line text-[13px] font-semibold text-fg" title="Logged in as <%= user.name %> (<%= user.email %>)"><% if (userAvatar) { %><img src="<%= userAvatar %>" alt="" class="h-full w-full rounded-full object-cover"><% } else { %><%= (user.name || "?").trim().charAt(0).toUpperCase() %><% } %></span>
    <button type="submit" class="flex h-8 w-8 items-center justify-center rounded-lg text-dim hover:bg-line/50 hover:text-fg" aria-label="Log out" title="Log out <%= user.name %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-2" /><path d="M10 12h10" /><path d="m17 9 3 3-3 3" />
      </svg>
    </button>
  </form>
</nav>

<div class="app-main sm:pl-[72px] max-sm:pb-14">
<div id="status" class="toast" role="status" aria-live="polite">
  <span class="toast-icon"></span>
  <span class="toast-text"></span>
  <button type="button" class="toast-close" aria-label="Dismiss">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>
</div>
<%# Up to three columns: on project pages, the list of your projects
    (#project-list-root, drawn by public/js/app/projects.js; under 1280px it
    opens over the page instead, from the toolbar's Projects), the page
    itself, and from a 2072px window the Add/Edit project form
    (#create-side, filled by renderCreateForm in
    public/js/legacy/project-form.js). The page's layouts follow its own
    column's width (container queries on .app-content), not the window's. %>
<div class="app-columns">
<div id="project-list-root" class="tw-reset contents"></div>
<div class="app-content">
<%# Project pages only: the project list (under 1280px), back to a
    section's project, then the project's own line over its header box
    (#project-bar, filled by buildProjectBar in
    public/js/legacy/project-page.js): its name, port, Switch, Eject and
    Sync, and its actions at the right end. %>
<div id="toolbar" class="toolbar" hidden>
  <div class="toolbar-left">
    <button id="project-list-btn" class="toolbar-link project-list-btn" type="button" aria-label="Your projects" title="Your projects">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>Projects
    </button>
    <a id="back-link" class="toolbar-link" href="/" data-route hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </a>
  </div>
  <div id="project-bar" class="project-bar"></div>
</div>

<div id="project-view" class="project-view" hidden></div>

<%# Home, and /projects while it finds your first project (or has none to
    show): drawn by public/js/app (Preact). %>
<div id="app-view" class="tw-reset" data-user="<%= user.name %>" hidden></div>
</div>
<aside id="create-side" class="create-side" aria-label="Add project" hidden>
  <div id="create-project-side"></div>
</aside>
</div>
</div>

<%# The Add/Edit project form, sliding in from the right. %>
<div id="create-drawer" class="drawer-overlay" hidden>
  <aside class="drawer-panel" aria-label="Project details">
    <div id="create-project"></div>
  </aside>
</div>

<div id="confirm-overlay" class="modal-overlay confirm-overlay" hidden>
  <div id="confirm-panel" class="modal-panel-inner confirm-panel" role="alertdialog" aria-modal="true"></div>
</div>

<div id="new-folders-overlay" class="modal-overlay" hidden>
  <div id="new-folders-panel"></div>
</div>

<div id="palette-root" class="tw-reset"></div>

<script src="/js/legacy/constants.js" defer></script>
<script src="/js/legacy/state.js" defer></script>
<script src="/js/legacy/ui.js" defer></script>
<script src="/js/legacy/api.js" defer></script>
<script src="/js/legacy/registry.js" defer></script>
<script src="/js/legacy/ports.js" defer></script>
<script src="/js/legacy/project-form.js" defer></script>
<script src="/js/legacy/explorer.js" defer></script>
<script src="/js/legacy/history.js" defer></script>
<script src="/js/legacy/journal.js" defer></script>
<script src="/js/legacy/tasks.js" defer></script>
<script src="/js/legacy/staff.js" defer></script>
<script src="/js/legacy/project-page.js" defer></script>
<script src="/js/legacy/router.js" defer></script>
<script src="/js/legacy/boot.js" defer></script>
<script type="module" src="/js/app/main.js"></script>
</body>
</html>
