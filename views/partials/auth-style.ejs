<%# The logged-out pages' look: the login page and the password links' page
    (views/login.ejs, views/password.ejs). %>
<style>
  /* The dashboard's colors and type (views/index.ejs :root) */
  :root {
    color-scheme: light dark;
    --bg: #f5f5f4;
    --panel: #ffffff;
    --border: #e2e0dc;
    --text: #1c1917;
    --text-dim: #78716c;
    --accent: #2563eb;
    --danger: #dc2626;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #18181b;
      --panel: #232326;
      --border: #38383c;
      --text: #f4f4f5;
      --text-dim: #a1a1aa;
      --danger: #f87171;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: var(--bg);
    color: var(--text);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .login {
    width: 100%;
    max-width: 340px;
  }
  .login-heading { margin: 0 0 20px; text-align: center; }
  .login-title { margin: 0; font-size: 22px; font-weight: 600; }
  .login-subtitle { margin: 2px 0 0; font-size: 13px; color: var(--text-dim); }
  .login-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .login-error {
    margin: 0;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 8%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--danger) 45%, var(--border));
    border-radius: 6px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-size: 13px; font-weight: 600; }
  .field-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 13px;
  }
  .field-input:focus { outline: none; border-color: var(--accent); }
  .login-btn {
    margin-top: 4px;
    padding: 9px 12px;
    border: none;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .login-btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
  .login-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .login-text { margin: 0; font-size: 13px; }
  .login-text strong { font-weight: 600; overflow-wrap: anywhere; }
  .field-hint { font-size: 12px; color: var(--text-dim); }
  .login-link { color: var(--accent); font-size: 13px; text-align: center; text-decoration: none; }
  .login-link:hover { text-decoration: underline; }
</style>
